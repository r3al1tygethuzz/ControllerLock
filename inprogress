    Body.Font = Enum.Font.Gotham
    Body.Text = tostring(MessageText or "")
    Body.TextColor3 = GRAY
    Body.TextSize = 10
    Body.TextWrapped = true
    Body.TextXAlignment = Enum.TextXAlignment.Left
    Body.TextYAlignment = Enum.TextYAlignment.Top
    Body.TextTransparency = 1
    Body.ZIndex = 2000002
    Body.Parent = Card

    local Item = {Frame = Card}
    table.insert(ActiveNotifications, Item)
    XenonFunctions.ReflowNotifications()
    TweenService:Create(Card, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        {Position = UDim2.new(0, 0, 0, (#ActiveNotifications - 1) * 82), BackgroundTransparency = 0}):Play()
    TweenService:Create(Accent, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
    TweenService:Create(Heading, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
    TweenService:Create(Body, TweenInfo.new(0.2), {TextTransparency = 0}):Play()

    task.delay(Lifetime, function()
        if not Card.Parent then return end
        local ExitTween = TweenService:Create(Card, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {Position = UDim2.new(0, 300, 0, Card.Position.Y.Offset), BackgroundTransparency = 1})
        TweenService:Create(Accent, TweenInfo.new(0.18), {BackgroundTransparency = 1}):Play()
        TweenService:Create(Heading, TweenInfo.new(0.18), {TextTransparency = 1}):Play()
        TweenService:Create(Body, TweenInfo.new(0.18), {TextTransparency = 1}):Play()
        ExitTween:Play()
        task.delay(0.22, function()
            for Index, Existing in ipairs(ActiveNotifications) do
                if Existing == Item then table.remove(ActiveNotifications, Index) break end
            end
            if Card.Parent then Card:Destroy() end
            XenonFunctions.ReflowNotifications()
        end)
    end)
end


