--==============================================================
-- PER-USER CONFIGURATION MANAGER
--==============================================================
-- Uses the existing executor file APIs when available. A normal Roblox
-- LocalScript cannot access DataStores; without these APIs, settings remain
-- at defaults for the current session only.

local Notify
local RefreshConfigControls
local ConfigVersion = 2
local ConfigDefaults = table.clone(Config)
local ConfigLoadWarnings = 0
local ConfigWasLoaded = false
local ConfigDirty = false
local SaveGeneration = 0
local SettingsFileName = "XenonSettings_" .. tostring(LocalPlayer.UserId) .. ".json"

function XenonFunctions.SerializeConfig()
    local Data = {}
    for Key, Value in pairs(Config) do
        if typeof(Value) == "EnumItem" then
            Data[Key] = {__type = "EnumItem", enum = tostring(Value.EnumType), name = Value.Name}
        elseif type(Value) == "number" or type(Value) == "boolean" or type(Value) == "string" then
            Data[Key] = Value
        end
    end
    return Data
end

function XenonFunctions.ValidateConfigValue(Key, Value)
    local Default = ConfigDefaults[Key]
    if Default == nil then return nil, false end
    if typeof(Default) == "EnumItem" then
        if type(Value) ~= "table" or Value.__type ~= "EnumItem" or type(Value.name) ~= "string" then return nil, false end
        if Key == "LockButton" then
            local Button = Enum.KeyCode[Value.name]
            return Button, Button ~= nil
        end
        return nil, false
    end
    if type(Value) ~= type(Default) then return nil, false end
    if type(Value) == "number" then
        if Value ~= Value or Value == math.huge or Value == -math.huge then return nil, false end
        local Limits = {
            AimOffset = {-100, 100}, Smoothing = {0, 100}, Prediction = {0, 5},
            HealthThreshold = {0, 1000}, ReferenceDistance = {1, 10000},
            ThirdPersonAnchor = {0, 1}, ThirdPersonCalibrationDistance = {1, 10000},
            ThirdPersonMinOffset = {-1000, 1000}, ThirdPersonMaxOffset = {-1000, 1000},
            MaxTargetDistance = {1, 10000},
        }
        local Range = Limits[Key]
        if Range then Value = math.clamp(Value, Range[1], Range[2]) end
    elseif Key == "CameraMode" then
        if Value ~= "First Person" and Value ~= "Third Person" then return nil, false end
    elseif Key == "SelectedTab" then
        if Value ~= "AIM" and Value ~= "VISUALS" and Value ~= "WHITELIST" and Value ~= "SUPPORTED" then return nil, false end
    end
    return Value, true
end

function XenonFunctions.ApplyConfigDefaults()
    for Key, Value in pairs(ConfigDefaults) do Config[Key] = Value end
end

function XenonFunctions.WriteSettingsNow()
    if not LoaderState.Capabilities.writefile or type(writefile) ~= "function" then
        return false, "File writing is unavailable"
    end
    local Payload = {version = ConfigVersion, userId = LocalPlayer.UserId, settings = XenonFunctions.SerializeConfig()}
    local Success, ErrorMessage = pcall(function()
        writefile(SettingsFileName, HttpService:JSONEncode(Payload))
    end)
    if Success then
        ConfigDirty = false
        if Notify then Notify("success", "Configuration saved", "Your Xenon settings were saved.", 2.2) end
        return true
    end
    if Notify then Notify("error", "Save failed", tostring(ErrorMessage), 4) end
    return false, tostring(ErrorMessage)
end

function XenonFunctions.SaveSettings(Force)
    ConfigDirty = true
    if not LoaderState.Capabilities.writefile or type(writefile) ~= "function" then return false end
    SaveGeneration += 1
    local Generation = SaveGeneration
    if Force then return XenonFunctions.WriteSettingsNow() end
    task.delay(0.35, function()
        if Generation == SaveGeneration and ConfigDirty then XenonFunctions.WriteSettingsNow() end
    end)
    return true
end

function XenonFunctions.UpdateConfigSetting(Key, Value)
    local Validated, IsValid = XenonFunctions.ValidateConfigValue(Key, Value)
    if not IsValid then
        if Notify then Notify("warning", "Invalid setting", "The value for " .. tostring(Key) .. " was rejected.", 3) end
        return false
    end
    Config[Key] = Validated
    XenonFunctions.SaveSettings()
    return true
end

function XenonFunctions.ResetConfiguration()
    XenonFunctions.ApplyConfigDefaults()
    if RefreshConfigControls then RefreshConfigControls() end
    XenonFunctions.SaveSettings(true)
    if Notify then Notify("success", "Settings reset", "Xenon settings were restored to defaults.", 3) end
end

XenonFunctions.RunLoadingStage(5, "Checking settings support", function()
