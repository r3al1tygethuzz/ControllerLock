end

--==============================================================
-- LOCK
--==============================================================

function XenonFunctions.Lock()
if Locked then
XenonFunctions.Unlock()
return
end

local Target =
    XenonFunctions.FindTarget()

if not Target then
    XenonFunctions.UpdateStatus()
    return
end

if Config.AimbotWhitelistSkip
    and XenonFunctions.IsWhitelisted(Target) then

    return
end

if not XenonFunctions.IsTargetLockable(Target) then
    XenonFunctions.UpdateStatus()
    return
end

LockedTarget =
    Target

Locked = true

XenonFunctions.UpdateStatus()
if Notify then Notify("success", "Camera lock", "Locked onto " .. Target.Name .. ".", 2) end

end

--==============================================================
-- TARGET VALIDATION
--==============================================================

function XenonFunctions.IsTargetValid(Player)
if not Player then
return false
end

if Player.Parent ~= Players then
    return false
end

if Config.AimbotWhitelistSkip
    and XenonFunctions.IsWhitelisted(Player) then

    return false
end

local Character,
    Humanoid,
    Root =
    XenonFunctions.GetCharacterData(Player)

if Character == nil
    or Humanoid == nil
    or Root == nil then

    return false
end

-- Revalidate the active target against the same down/wall checks.
return XenonFunctions.IsTargetLockable(Player)

end

