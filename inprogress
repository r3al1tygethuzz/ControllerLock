--==============================================================
-- WHITELIST STORAGE
--==============================================================

local WhitelistFileName = "XenonWhitelist_" .. tostring(LocalPlayer.UserId) .. ".json"

function XenonFunctions.LoadWhitelist()
table.clear(Whitelist)

if not LoaderState.Capabilities.isfile
    or not LoaderState.Capabilities.readfile then
    return
end

if type(isfile) ~= "function" then
    return
end

if type(readfile) ~= "function" then
    return
end

local Success, Data = pcall(function()
    if not isfile(WhitelistFileName) then
        return nil
    end

    return readfile(WhitelistFileName)
end)

if not Success or not Data or Data == "" then
    return
end

local DecodeSuccess, Decoded = pcall(function()
    return HttpService:JSONDecode(Data)
end)
if not DecodeSuccess or type(Decoded) ~= "table" then return end
if Decoded.userId ~= nil and tonumber(Decoded.userId) ~= LocalPlayer.UserId then return end
local Entries = Decoded.entries or Decoded
if type(Entries) ~= "table" then return end
for _, UserId in ipairs(Entries) do
    local NumberId = tonumber(UserId)

    if NumberId then
        -- UserId-keyed storage naturally collapses duplicate entries.
        Whitelist[NumberId] = true
    end
end

end

function XenonFunctions.SaveWhitelist()
if not LoaderState.Capabilities.writefile then
return
end

if type(writefile) ~= "function" then
return
end

local Data = {}

local Seen = {}

for UserId, IsWhitelisted in pairs(Whitelist) do
    local NumberId = tonumber(UserId)

    if IsWhitelisted and NumberId and not Seen[NumberId] then
        Seen[NumberId] = true
        table.insert(Data, NumberId)
    end
end

table.sort(Data)

local Success, ErrorMessage = pcall(function()
    writefile(WhitelistFileName, HttpService:JSONEncode({
        version = 1, userId = LocalPlayer.UserId, entries = Data,
    }))
end)
if not Success and Notify then
    Notify("error", "Whitelist save failed", tostring(ErrorMessage), 4)
end
end

XenonFunctions.RunLoadingStage(7, "Loading whitelist", function()
    XenonFunctions.LoadWhitelist()
end)

function XenonFunctions.IsWhitelisted(Player)
if not Player then
return false
end

return Whitelist[Player.UserId] == true

end

function XenonFunctions.SetWhitelist(Player, State)
if not Player then
return
end

if State then
    Whitelist[Player.UserId] = true
else
    Whitelist[Player.UserId] = nil
end

XenonFunctions.SaveWhitelist()
if Notify then
    Notify("information", "Whitelist updated", Player.Name .. (State and " was added." or " was removed."), 2)
end

end

