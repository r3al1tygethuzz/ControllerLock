function XenonFunctions.LoaderWarning(Message)
    table.insert(LoaderState.Warnings, tostring(Message))
end

function XenonFunctions.SetLoadingStage(Number, Text)
    LoaderState.Stage = Number

    if LoaderStatus then
        LoaderStatus.Text = tostring(Number) .. "/15 — " .. Text
    end

    if LoaderPercent then
        LoaderPercent.Text = tostring(math.floor((Number - 1) / 15 * 100)) .. "%"
    end

    if LoaderProgress then
        LoaderProgress.Size = UDim2.new((Number - 1) / 15, 0, 1, 0)
    end
end

function XenonFunctions.CompleteLoadingStage(Number)
    if LoaderPercent then
        LoaderPercent.Text = tostring(math.floor(Number / 15 * 100)) .. "%"
    end

    if LoaderProgress then
        LoaderProgress.Size = UDim2.new(Number / 15, 0, 1, 0)
    end
end

function XenonFunctions.RunLoadingStage(Number, Text, Work)
    XenonFunctions.SetLoadingStage(Number, Text)

    local Success, Result = pcall(Work)
    if not Success then
        XenonFunctions.LoaderWarning(Text .. " unavailable — using fallback")
        Result = nil
    end

    XenonFunctions.CompleteLoadingStage(Number)
    return Success, Result
end

