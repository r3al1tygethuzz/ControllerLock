function XenonFunctions.LoadSettings()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return false end
    local Success, Data = pcall(function()
        if not isfile(SettingsFileName) then return nil end
        return readfile(SettingsFileName)
    end)
    if not Success or type(Data) ~= "string" or Data == "" then return false end
    local DecodeSuccess, Saved = pcall(function() return HttpService:JSONDecode(Data) end)
    if not DecodeSuccess or type(Saved) ~= "table" then
        ConfigLoadWarnings += 1
        return false
    end
    local StoredVersion = tonumber(Saved.version)
    if StoredVersion and StoredVersion > ConfigVersion then
        ConfigLoadWarnings += 1
        return false
    end
    -- Migrate the previous flat settings file and accept the versioned envelope.
    local SavedSettings = type(Saved.settings) == "table" and Saved.settings or Saved
    if Saved.userId ~= nil and tonumber(Saved.userId) ~= LocalPlayer.UserId then
        ConfigLoadWarnings += 1
        return false
    end
    for Key, Value in pairs(SavedSettings) do
        if ConfigDefaults[Key] ~= nil then
            local Validated, IsValid = XenonFunctions.ValidateConfigValue(Key, Value)
            if IsValid then Config[Key] = Validated else ConfigLoadWarnings += 1 end
        end
    end
    ConfigWasLoaded = true
    return true
end

