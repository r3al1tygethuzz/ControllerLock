local SearchResultObjects = {}
function XenonFunctions.ClearSearchResults()
    for _, Object in ipairs(SearchResultObjects) do
        if Object and Object.Parent then Object:Destroy() end
    end
    table.clear(SearchResultObjects)
end

function XenonFunctions.NavigateToFeature(Feature)
    local Containers = {AIM = Scroll, VISUALS = VisualsTab, WHITELIST = WhitelistTab, SUPPORTED = SupportedTab}
    local Container = Containers[Feature.Tab]
    if not Container or not Feature.Target or not Feature.Target.Parent then
        if Notify then Notify("warning", "Navigation unavailable", "That control is no longer available.", 3) end
        return
    end
    XenonFunctions.SetActiveTab(Feature.Tab)
    SearchResultsFrame.Visible = false
    SearchBar.Text = ""
    task.defer(function()
        if Feature.Target.Parent and Container.Parent then
            local Y = Feature.Target.AbsolutePosition.Y - Container.AbsolutePosition.Y + Container.CanvasPosition.Y
            Container.CanvasPosition = Vector2.new(0, math.max(0, Y - 8))
        end
    end)
end

function XenonFunctions.UpdateFeatureSearch(Query)
    XenonFunctions.ClearSearchResults()
    Query = string.lower(tostring(Query or "")):gsub("^%s+", ""):gsub("%s+$", "")
    if Query == "" then
        SearchResultsFrame.Visible = false
        SearchResultsFrame.Size = UDim2.new(1, -20, 0, 0)
        return
    end

    local Matches = {}
    for _, Feature in ipairs(FeatureRegistry) do
        local Haystack = string.lower(Feature.Name .. " " .. Feature.Description .. " " .. Feature.Category)
        local Match = string.find(Haystack, Query, 1, true) ~= nil
        if not Match then
            for _, Alias in ipairs(Feature.Aliases) do
                if string.find(string.lower(Alias), Query, 1, true) then Match = true break end
            end
        end
        if Match then table.insert(Matches, Feature) end
    end

    SearchResultsFrame.Visible = true
    if #Matches == 0 then
        SearchResultsFrame.Size = UDim2.new(1, -20, 0, 42)
        local Empty = Instance.new("TextLabel")
        Empty.Name = "NoResults"
        Empty.Size = UDim2.new(1, 0, 0, 32)
        Empty.BackgroundTransparency = 1
        Empty.Text = "No matching features found"
        Empty.TextColor3 = GRAY
        Empty.TextSize = 10
        Empty.Font = Enum.Font.Gotham
        Empty.ZIndex = 50002
        Empty.Parent = SearchResultsFrame
        table.insert(SearchResultObjects, Empty)
        return
    end

    local Count = math.min(#Matches, 5)
    SearchResultsFrame.Size = UDim2.new(1, -20, 0, Count * 34 + 8)
    for Index = 1, Count do
        local Feature = Matches[Index]
        local Button = Instance.new("TextButton")
        Button.Name = "SearchResult_" .. tostring(Index)
        Button.Size = UDim2.new(1, 0, 0, 31)
        Button.BackgroundColor3 = DARK
        Button.BorderSizePixel = 0
        Button.Text = Feature.Name .. "  ·  " .. Feature.Category
        Button.TextColor3 = WHITE
        Button.TextSize = 10
        Button.Font = Enum.Font.GothamMedium
        Button.TextXAlignment = Enum.TextXAlignment.Left
        Button.AutoButtonColor = false
        Button.ZIndex = 50002
        Button.Parent = SearchResultsFrame
        local Padding = Instance.new("UIPadding")
        Padding.PaddingLeft = UDim.new(0, 9)
        Padding.Parent = Button
        XenonFunctions.Connect(Button.Activated, function() XenonFunctions.NavigateToFeature(Feature) end)
        table.insert(SearchResultObjects, Button)
    end
end

